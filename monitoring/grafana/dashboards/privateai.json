    {
      "id": 10,
      "title": "Policy lookup latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "description": "Includes authoritative PostgreSQL version checks. Percentiles estimated from histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "privateai-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(privateai_policy_lookup_seconds_bucket{job=~\"privateai-gateway|privateai-worker\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "privateai-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(privateai_policy_lookup_seconds_bucket{job=~\"privateai-gateway|privateai-worker\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "privateai-prometheus"
          }
        },
