    {
      "id": 15,
      "title": "Firing Prometheus alerts",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "description": "No series normally means no firing alerts, provided Prometheus is reachable. These are rule states, not proof a notification was delivered. Includes all rules in this Prometheus server.",
      "datasource": {
        "type": "prometheus",
        "uid": "privateai-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alertname) (ALERTS{alertstate=\"firing\"})",
