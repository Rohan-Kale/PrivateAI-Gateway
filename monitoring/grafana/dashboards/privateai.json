    {
      "id": 12,
      "title": "Approximate mean engine duration",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "description": "Duration is added at completion, while request count increments at entry: window-boundary in-flight work makes this approximate. Includes blocks/errors/cache hits; excludes queue wait. No request-latency histogram exists, so this is not p95/p99.",
      "datasource": {
        "type": "prometheus",
        "uid": "privateai-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(privateai_request_duration_seconds_sum{job=~\"privateai-gateway|privateai-worker\"}[$__rate_interval])) / sum(rate(privateai_request_duration_seconds_count{job=~\"privateai-gateway|privateai-worker\"}[$__rate_interval]))",
          "legendFormat": "Mean",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "privateai-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
