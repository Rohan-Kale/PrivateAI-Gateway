          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(privateai_policy_lookup_seconds_bucket{job=~\"privateai-gateway|privateai-worker\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "privateai-prometheus"
          }
