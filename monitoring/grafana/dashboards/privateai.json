{
  "uid": "privateai-overview",
  "title": "PrivateAI Gateway Overview",
  "description": "Operational metrics from the existing gateway and workers; provisioned from the repository.",
  "tags": [
    "privateai",
    "prometheus"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "PrivateAI Gateway \u00b7 Operations",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "description": "",
      "options": {
        "mode": "markdown",
        "content": "**Live service metrics \u00b7 no prompt content**\n\nRequests include direct calls and worker attempts (including retries/cache hits). Policy blocks are separate from other errors. Queue depth includes claimed, unfinished jobs and is counted once across replicas. Histogram percentiles are estimates; no traffic can show **No data**. Health panels show scrape reachability, not full dependency readiness. The default model is a local echo provider."
      }
    },
    {
      "id": 2,
      "title": "Inference attempts / second",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "privateai-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(privateai_requests_total{job=~\"privateai-gateway|privateai-worker\"}[$__rate_interval]))",
          "legendFormat": "Attempts/s",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "privateai-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
