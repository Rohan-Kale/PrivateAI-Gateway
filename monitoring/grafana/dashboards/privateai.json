    {
      "id": 7,
      "title": "Policy blocks and other errors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "description": "The errors counter includes policy blocks; subtracting blocks prevents double counting. Other errors include capacity rejection and dependency failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "privateai-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(privateai_blocked_total{job=~\"privateai-gateway|privateai-worker\"}[$__rate_interval]))",
          "legendFormat": "Policy blocks",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "privateai-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "clamp_min(sum(rate(privateai_errors_total{job=~\"privateai-gateway|privateai-worker\"}[$__rate_interval])) - sum(rate(privateai_blocked_total{job=~\"privateai-gateway|privateai-worker\"}[$__rate_interval])), 0)",
          "legendFormat": "Other errors",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "privateai-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
