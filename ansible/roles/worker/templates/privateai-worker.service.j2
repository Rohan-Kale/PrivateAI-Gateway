[Unit]
Description=PrivateAI inference worker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=70
ExecStartPre=-/usr/bin/docker rm -f privateai-worker
ExecStart=/usr/bin/docker run --name privateai-worker --read-only --cap-drop=ALL --security-opt=no-new-privileges --env-file={{ privateai_env_file }} -p 127.0.0.1:8081:8080 {{ privateai_image }} worker
ExecStop=/usr/bin/docker stop -t 60 privateai-worker
ExecStopPost=-/usr/bin/docker rm privateai-worker

[Install]
WantedBy=multi-user.target
